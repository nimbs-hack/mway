+const parallelCompileExtensions = new WeakMap();
+
+// Start linking without waiting for the driver. The next bind finishes
+// initialization using this same program once compilation has completed.
+ShaderProgram.prototype._isReady = function () {
+  if (defined(this._program)) {
+    return true;
+  }
+  const gl = this._gl;
+  if (!parallelCompileExtensions.has(gl)) {
+    parallelCompileExtensions.set(gl, gl.getExtension("KHR_parallel_shader_compile"));
+  }
+  const extension = parallelCompileExtensions.get(gl);
+  if (!extension) {
+    return true;
+  }
+  this._pendingLink ??= startLink(gl, this);
+  return gl.getProgramParameter(
+    this._pendingLink.program,
+    extension.COMPLETION_STATUS_KHR,
+  );
+};
